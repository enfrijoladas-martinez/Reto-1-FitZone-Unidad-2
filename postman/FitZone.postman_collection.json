    {
      "name": "3 · inscribirEnClase (tarea)",
      "item": [
        {
          "name": "Inscribir a Ana en Yoga (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idSocio\": 1,\n  \"idClase\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/inscripciones",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "inscripciones"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"idInscripcion\", pm.response.json().idInscripcion);"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar la inscripción",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/inscripciones/{{idInscripcion}}",
